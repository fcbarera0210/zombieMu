@page "/character-leaderboards"

@using MUnique.OpenMU.Web.AdminPanel.Properties
@using MUnique.OpenMU.Web.AdminPanel.Operations

<PageTitle>OpenMU: @Resources.CharacterLeaderboards</PageTitle>
<Breadcrumb IsFirstFromRoot="true" Caption="@Resources.CharacterLeaderboards" />
<h1>@Resources.CharacterLeaderboards</h1>

<p class="text-muted">@Resources.CharacterLeaderboardsDescription</p>

<div class="table-responsive">
<table class="table table-striped table-sm">
    <thead>
    <tr>
        <th class="text-end">#</th>
        <th>@Resources.Character</th>
        <th>@Resources.CharacterClass</th>
        <th class="text-end">@Resources.Resets</th>
        <th class="text-end">@Resources.MasterLevel</th>
        <th class="text-end">@Resources.Level</th>
    </tr>
    </thead>
    <tbody>
    @foreach (var entry in this.Entries)
    {
        <tr>
            <td class="text-end">@entry.Rank</td>
            <td>@entry.CharacterName</td>
            <td>@entry.ClassName</td>
            <td class="text-end">@entry.Resets.ToString("N0")</td>
            <td class="text-end">@entry.MasterLevel.ToString("N0")</td>
            <td class="text-end">@entry.Level.ToString("N0")</td>
        </tr>
    }
    @if (this.Entries.Count == 0)
    {
        <tr>
            <td colspan="6" class="text-muted">@(this.IsLoading ? Resources.Loading : Resources.CharacterLeaderboardNoEntries)</td>
        </tr>
    }
    </tbody>
</table>
</div>
