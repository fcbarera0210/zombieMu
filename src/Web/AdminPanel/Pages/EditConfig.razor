@inherits EditBase

@using MUnique.OpenMU.DataModel.Configuration.Items
@using MUnique.OpenMU.DataModel.Entities
@using MUnique.OpenMU.Web.AdminPanel.Components.ItemEdit
@using MUnique.OpenMU.Web.AdminPanel.Components.Layout
@using MUnique.OpenMU.Web.Shared.Components.ItemEdit

<EditShell Model="@this.Model" ModelType="@this.Type" PersistenceContext="@this.PersistenceContext" IsOwningContext="@this.IsOwningContext" DownloadMarkup="@this.DownloadMarkup" EditorsMarkup="@this.GetEditorsMarkup()">
    @if (this.Type == typeof(Item))
    {
        <ItemEdit Item="@((Item)this.Model!)" OnValidSubmit="this.SaveChangesAsync" />
    }
    else if (this.IsItemDefinition)
    {
        <ItemDefinitionEditor Item="@((ItemDefinition)this.Model!)" OnValidSubmit="this.SaveChangesAsync" OnRefresh="this.RefreshAsync" />
    }
    else if (this.IsItemOptionDefinition)
    {
        <ItemOptionEditor Definition="@((ItemOptionDefinition)this.Model!)" OnValidSubmit="this.SaveChangesAsync" OnRefresh="this.RefreshAsync" />
    }
    else if (this.IsIncreasableItemOption)
    {
        <ItemOptionEditor Option="@((IncreasableItemOption)this.Model!)" OnValidSubmit="this.SaveChangesAsync" OnRefresh="this.RefreshAsync" />
    }
    else if (this.AutoFormType is not null)
    {
        <DynamicComponent Type="@this.AutoFormType" Parameters="@this.AutoFormParameters" />
    }
</EditShell>
