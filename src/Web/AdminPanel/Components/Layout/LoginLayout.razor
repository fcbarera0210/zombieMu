@inherits LayoutComponentBase
@using MUnique.OpenMU.Web.AdminPanel.Properties

<div class="login-layout d-flex flex-column align-items-center justify-content-center min-vh-100 px-3">
    <div class="login-panel w-100">
        <h1 class="login-brand text-center">
            <span class="login-brand-mark" aria-hidden="true"></span>Zombie Mu
        </h1>
        <p class="login-subtitle text-center">Admin Panel</p>
        @Body
    </div>
</div>

<ToastContainer />

<div id="blazor-error-ui" data-nosnippet>
    @Resources.UnhandledErrorOccurred
    <a href="." class="reload">@Resources.Reload</a>
    <span class="dismiss">🗙</span>
</div>
